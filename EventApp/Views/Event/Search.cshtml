@model IEnumerable<EventApp.Models.Event>

@{
    ViewData["Title"] = "Search Events";

    var searchTitle = ViewBag.SearchTitle as string ?? string.Empty;
    var selectedCategory = ViewBag.SelectedCategory as string ?? string.Empty;
    var startDate = ViewBag.StartDate as string ?? string.Empty;
    var endDate = ViewBag.EndDate as string ?? string.Empty;
    var ticketStatus = ViewBag.TicketStatus as string ?? string.Empty;
    var sortOrder = ViewBag.SortOrder as string ?? "Date";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var filterError = ViewBag.FilterError as string;
}

<div class="container mt-5">
    <h1 class="text-primary mb-4 fw-bold">Search and Filter Events</h1>

    @if (!string.IsNullOrWhiteSpace(filterError))
    {
        <div class="alert alert-warning">@filterError</div>
    }

    <form method="get" asp-action="Search" class="p-4 mb-5 border rounded-3 bg-light shadow-sm">
        <div class="row g-3 align-items-end">
            <div class="col-md-4 col-lg-3">
                <label for="searchTitle" class="form-label fw-semibold">Search Title</label>
                <input type="text" id="searchTitle" name="searchTitle" value="@searchTitle" class="form-control" placeholder="Concert, workshop, meetup" />
            </div>

            <div class="col-md-4 col-lg-3">
                <label for="category" class="form-label fw-semibold">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="">All Categories</option>
                    @foreach (var category in categories)
                    {
                        if (category == selectedCategory)
                        {
                            <option value="@category" selected>@category</option>
                        }
                        else
                        {
                            <option value="@category">@category</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-4 col-lg-3">
                <label for="startDate" class="form-label fw-semibold">Start Date</label>
                <input type="date" id="startDate" name="startDate" value="@startDate" class="form-control" />
            </div>

            <div class="col-md-4 col-lg-3">
                <label for="endDate" class="form-label fw-semibold">End Date</label>
                <input type="date" id="endDate" name="endDate" value="@endDate" class="form-control" />
            </div>

            <div class="col-md-4 col-lg-3">
                <label for="ticketStatus" class="form-label fw-semibold">Ticket Status</label>
                <select id="ticketStatus" name="ticketStatus" class="form-select">
                    <option value="">All Status</option>
                    @if (ticketStatus == "Available")
                    {
                        <option value="Available" selected>Available</option>
                    }
                    else
                    {
                        <option value="Available">Available</option>
                    }

                    @if (ticketStatus == "SoldOut")
                    {
                        <option value="SoldOut" selected>Sold Out</option>
                    }
                    else
                    {
                        <option value="SoldOut">Sold Out</option>
                    }
                </select>
            </div>

            <div class="col-md-4 col-lg-3">
                <label for="sortOrder" class="form-label fw-semibold">Sort By</label>
                <select id="sortOrder" name="sortOrder" class="form-select">
                    @if (sortOrder == "Date")
                    {
                        <option value="Date" selected>Date</option>
                    }
                    else
                    {
                        <option value="Date">Date</option>
                    }

                    @if (sortOrder == "Title")
                    {
                        <option value="Title" selected>Title</option>
                    }
                    else
                    {
                        <option value="Title">Title</option>
                    }

                    @if (sortOrder == "Price")
                    {
                        <option value="Price" selected>Price</option>
                    }
                    else
                    {
                        <option value="Price">Price</option>
                    }
                </select>
            </div>

            <div class="col-md-4 col-lg-2 d-grid">
                <button type="submit" class="btn btn-primary h-100">
                    <i class="bi bi-search me-2"></i>Search
                </button>
            </div>

            <div class="col-md-4 col-lg-2 d-grid">
                <a asp-action="Search" class="btn btn-outline-secondary h-100">
                    <i class="bi bi-x-circle me-2"></i>Clear Filters
                </a>
            </div>
        </div>
    </form>

    @if (Model.Any())
    {
        <h2 class="h4 mb-3">Found @Model.Count() Event(s)</h2>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Price</th>
                        <th>Available</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eventItem in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@eventItem.Id" class="text-primary fw-semibold">
                                    @eventItem.Title
                                </a>
                            </td>
                            <td>@eventItem.Category</td>
                            <td>@eventItem.Location</td>
                            <td>@eventItem.EventDate.ToShortDateString()</td>
                            <td>@eventItem.EventDate.ToShortTimeString()</td>
                            <td>@eventItem.TicketPrice.ToString("C")</td>
                            <td>@eventItem.AvailableTickets</td>
                            <td>
                                @if (eventItem.AvailableTickets > 0)
                                {
                                    <a asp-controller="Purchase" asp-action="Create" asp-route-eventId="@eventItem.Id" class="btn btn-success btn-sm">Buy Ticket</a>
                                }
                                else
                                {
                                    <span class="text-danger fw-semibold">Sold Out</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-5">
            <h4 class="alert-heading">No Events Found</h4>
            <p class="mb-0">No events match the current filters. Try widening the date range or clearing one of the filters.</p>
        </div>
    }
</div>
