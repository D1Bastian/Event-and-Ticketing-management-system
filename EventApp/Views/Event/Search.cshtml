@model IEnumerable<EventApp.Models.Event>

@{
    ViewData["Title"] = "Search Events";

    // Ensure ViewBag values have defaults to avoid null warnings
    var searchTitle = ViewBag.SearchTitle as string ?? "";
    var selectedCategory = ViewBag.SelectedCategory as string ?? "";
    var startDate = ViewBag.StartDate as string ?? "";
    var endDate = ViewBag.EndDate as string ?? "";
    var ticketStatus = ViewBag.TicketStatus as string ?? "";
    var sortOrder = ViewBag.SortOrder as string ?? "";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="container mt-5">
    <h2 class="text-primary mb-4 fw-bold">🔍 Search & Filter Events</h2>

    <form method="get" asp-action="Search" class="p-4 mb-5 border rounded-3 bg-light shadow-sm">
        <div class="row g-3 align-items-end">

            <!-- Search by title -->
            <div class="col-md-4 col-lg-3">
                <label for="searchTitle" class="form-label fw-semibold">Search Title</label>
                <input type="text" id="searchTitle" name="searchTitle" value="@searchTitle"
                       class="form-control" placeholder="e.g., Concert or Festival">
            </div>

            <!-- Category -->
            <div class="col-md-4 col-lg-3">
                <label for="category" class="form-label fw-semibold">Category</label>
                <select id="category" name="category" class="form-select">
                    <option value="">All Categories</option>

                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(cat == selectedCategory)">
                            @cat
                        </option>
                    }
                </select>
            </div>

            <!-- Date range -->
            <div class="col-md-4 col-lg-3">
                <label for="startDate" class="form-label fw-semibold">Start Date</label>
                <input type="date" id="startDate" name="startDate" value="@startDate" class="form-control">
            </div>

            <div class="col-md-4 col-lg-3">
                <label for="endDate" class="form-label fw-semibold">End Date</label>
                <input type="date" id="endDate" name="endDate" value="@endDate" class="form-control">
            </div>

            <!-- Ticket Status -->
            <div class="col-md-4 col-lg-3">
                <label for="ticketStatus" class="form-label fw-semibold">Ticket Status</label>
                <select id="ticketStatus" name="ticketStatus" class="form-select">
                    <option value="">All Status</option>
                    <option value="Available" selected="@(ticketStatus == "Available")">Available</option>
                    <option value="SoldOut" selected="@(ticketStatus == "SoldOut")">Sold Out</option>
                </select>
            </div>

            <!-- Sort Order -->
            <div class="col-md-4 col-lg-3">
                <label for="sortOrder" class="form-label fw-semibold">Sort By</label>
                <select id="sortOrder" name="sortOrder" class="form-select">
                    <option value="Date" selected="@(sortOrder == "Date")">Date</option>
                    <option value="Title" selected="@(sortOrder == "Title")">Title</option>
                    <option value="Price" selected="@(sortOrder == "Price")">Price</option>
                </select>
            </div>

            <!-- Search Button -->
            <div class="col-md-4 col-lg-2 d-grid">
                <button type="submit" class="btn btn-primary h-100">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>

            <!-- Clear Button -->
            <div class="col-md-4 col-lg-2 d-grid">
                <a asp-action="Search" class="btn btn-outline-secondary h-100">
                    <i class="bi bi-x-circle"></i> Clear Filters
                </a>
            </div>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <h4 class="mb-3">Found @Model.Count() Events</h4>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Price</th>
                        <th>Available</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@e.Id" class="text-primary fw-semibold">
                                    @e.Title
                                </a>
                            </td>
                            <td>@e.Category</td>
                            <td>@e.Location</td>
                            <td>@e.EventDate.ToShortDateString()</td>
                            <td>@e.EventDate.ToShortTimeString()</td>
                            <td>@e.TicketPrice.ToString("C")</td>
                            <td>@e.AvailableTickets</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-5">
            <h4 class="alert-heading">No Events Found</h4>
            <p class="mb-0">No events match your search/filter criteria. Try widening your search parameters.</p>
        </div>
    }
</div>
