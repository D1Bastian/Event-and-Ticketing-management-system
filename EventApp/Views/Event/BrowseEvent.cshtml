@model IEnumerable<EventApp.Models.Event>

@{
    ViewData["Title"] = "Browse Events";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCategory = ViewBag.SelectedCategory as string ?? string.Empty;
}

<div class="container mt-5">
    <h1 class="text-primary mb-4">Browse Events</h1>

    <form asp-action="BrowseEvent" method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <label for="category" class="form-label fw-semibold">Category</label>
            <select id="category" name="category" class="form-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @foreach (var category in categories)
                {
                    if (category == selectedCategory)
                    {
                        <option value="@category" selected>@category</option>
                    }
                    else
                    {
                        <option value="@category">@category</option>
                    }
                }
            </select>
        </div>
    </form>

    @if (Model.Any())
    {
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Date</th>
                <th>Time</th>
                <th>Ticket Price</th>
                <th>Available</th>
                <th>Action</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var eventItem in Model)
            {
                <tr>
                    <td>@eventItem.Title</td>
                    <td>@eventItem.Category</td>
                    <td>@eventItem.EventDate.ToShortDateString()</td>
                    <td>@eventItem.EventDate.ToShortTimeString()</td>
                    <td>@eventItem.TicketPrice.ToString("C")</td>
                    <td>@eventItem.AvailableTickets</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@eventItem.Id" class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info mb-0">
            No events found for this category.
        </div>
    }
</div>
