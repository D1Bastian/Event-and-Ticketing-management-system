@model IEnumerable<EventApp.Models.Event>
@{
    ViewData["Title"] = "Browse Events";
}

<div class="container mt-5">
    <h2 class="text-primary mb-4">🎟 Browse Events</h2>

    <form asp-action="BrowseEvent" method="get" class="row g-3 mb-4">
        <div class="col-md-6">
            <select name="category" class="form-select" onchange="this.form.submit()">
                <option value="">All Categories</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories as List<string>)
                    {
                        <option value="@cat" selected="@(cat == ViewBag.SelectedCategory ? "selected" : null)">@cat</option>
                    }
                }
            </select>

        </div>
    </form>

    @if (Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Date</th>
                <th>Time</th>
                <th>Ticket Price</th>
                <th>Available</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var e in Model)
            {
                <tr>
                    <td>@e.Title</td>
                    <td>@e.Category</td>
                    @* FIX: Use the correct property, EventDate, and format it for Date only *@
                    <td>@e.EventDate.ToShortDateString()</td> 
                    @* FIX: Use the correct property, EventDate, and format it for Time only *@
                    <td>@e.EventDate.ToShortTimeString()</td>
                    <td>@e.TicketPrice.ToString("C")</td> @* Use currency formatting *@
                    <td>@e.AvailableTickets</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No events found for this category.
        </div>
    }
</div>