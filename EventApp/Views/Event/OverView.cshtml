@model dynamic

@{
    ViewData["Title"] = "Event Overview";
}

<div class="container mt-5">
    <h2 class="text-primary mb-4">📊 Event Overview</h2>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-4">
            <div class="card text-center h-100 shadow-sm border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary fw-semibold">Total Events Scheduled</h5>
                    <h2 class="display-4 fw-bold">@ViewBag.TotalEvents</h2>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card text-center h-100 shadow-sm border-success">
                <div class="card-body">
                    <h5 class="card-title text-success fw-semibold">Unique Categories</h5>
                    <h2 class="display-4 fw-bold">@ViewBag.TotalCategories</h2>
                </div>
            </div>
        </div>
        
        <div class="col-md-6 col-lg-4">
            <div class="card text-center h-100 shadow-sm border-info">
                <div class="card-body">
                    <h5 class="card-title text-info fw-semibold">Total Tickets Available</h5>
                    <h2 class="display-4 fw-bold">@ViewBag.TotalAvailableTickets</h2>
                </div>
            </div>
        </div>
    </div>
    
    <hr class="my-4"/>
    <h4 class="text-warning mb-3 fw-bold">💰 Events with Ticket Price < $5 (Bargain Bin)</h4>
    <hr class="mb-4"/>
    
    @* FIX CS8602: Use 'is' to safely cast and check for null/count before iterating *@
    @if (ViewBag.LowPriceEvents is List<EventApp.Models.Event> lowPriceEvents && lowPriceEvents.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Price</th>
                    <th>Available Tickets</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var e in lowPriceEvents)
                {
                    <tr>
                        <td>@e.Title</td>
                        <td>@e.Category</td>
                        <td>@e.EventDate.ToShortDateString()</td>
                        <td class="text-warning fw-bold">@e.TicketPrice.ToString("C")</td>
                        <td>@e.AvailableTickets</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-success border-0 shadow-sm">
            <h5 class="alert-heading">🎉 Great News!</h5>
            <p class="mb-0">All listed events are priced at $5 or more. No super-low bargain events currently!</p>
        </div>
    }

</div>