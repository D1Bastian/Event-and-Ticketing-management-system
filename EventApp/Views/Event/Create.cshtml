@model EventApp.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="text-center text-primary mb-4 fw-bold">Add New Event</h2>

        <form asp-action="Create" method="post" class="needs-validation">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <div class="row g-3">
                
                <div class="col-md-12">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" placeholder="Enter event title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Provide a detailed description of the event"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <input asp-for="Category" class="form-control" placeholder="e.g. Music, Sports, Business" />
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Location" class="form-label fw-semibold"></label>
                    <input asp-for="Location" class="form-control" placeholder="Venue name or address" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                @* FIX: Use the unified EventDate property for both date and time input *@
                <div class="col-md-6">
                    <label asp-for="EventDate" class="form-label fw-semibold"></label>
                    <input asp-for="EventDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Capacity" class="form-label fw-semibold"></label>
                    <input asp-for="Capacity" type="number" class="form-control" placeholder="Maximum number of attendees" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TicketPrice" class="form-label fw-semibold"></label>
                    <input asp-for="TicketPrice" type="number" step="0.01" class="form-control" placeholder="Enter ticket price" />
                    <span asp-validation-for="TicketPrice" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="AvailableTickets" class="form-label fw-semibold"></label>
                    <input asp-for="AvailableTickets" type="number" class="form-control" placeholder="Initial available tickets" />
                    <span asp-validation-for="AvailableTickets" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle"></i> Save
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}