@model EventApp.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <h2 class="text-center text-warning mb-4 fw-bold">Edit Event</h2>

        <form asp-action="Edit" method="post">
            @* Hidden input for the primary key (Id) is crucial for the Edit POST action *@
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-12">
                    <label asp-for="Title" class="form-label fw-semibold"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label fw-semibold"></label>
                    <input asp-for="Category" class="form-control" />
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label fw-semibold"></label>
                    <input asp-for="Location" class="form-control" />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                @* FIX: Use the unified EventDate property with datetime-local type *@
                <div class="col-md-6">
                    <label asp-for="EventDate" class="form-label fw-semibold"></label>
                    <input asp-for="EventDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Capacity" class="form-label fw-semibold"></label>
                    <input asp-for="Capacity" type="number" class="form-control" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="TicketPrice" class="form-label fw-semibold"></label>
                    <input asp-for="TicketPrice" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="TicketPrice" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="AvailableTickets" class="form-label fw-semibold"></label>
                    <input asp-for="AvailableTickets" type="number" class="form-control" />
                    <span asp-validation-for="AvailableTickets" class="text-danger"></span>
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-warning px-4">
                    <i class="bi bi-save"></i> Update
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}