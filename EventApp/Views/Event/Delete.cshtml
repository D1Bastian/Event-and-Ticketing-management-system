@model EventApp.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-5">
    <div class="card border-danger shadow-lg p-4">
        <h2 class="text-danger fw-bold mb-4">Delete Event</h2>

        <h5>Are you sure you want to delete the event: <span class="text-secondary">@Model.Title</span>?</h5>

        <div class="mt-3">
            <dl class="row">
                <dt class="col-sm-3 fw-semibold">Title</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                @* FIX: Use the unified EventDate property for the date display *@
                <dt class="col-sm-3 fw-semibold">Date</dt>
                <dd class="col-sm-9">@Model.EventDate.ToShortDateString()</dd>

                @* FIX: Use the unified EventDate property for the time display *@
                <dt class="col-sm-3 fw-semibold">Time</dt>
                <dd class="col-sm-9">@Model.EventDate.ToShortTimeString()</dd>
                
                <dt class="col-sm-3 fw-semibold">Location</dt>
                <dd class="col-sm-9">@Model.Location</dd>
                
                <dt class="col-sm-3 fw-semibold">Price</dt>
                <dd class="col-sm-9">@Model.TicketPrice.ToString("C")</dd>
                
            </dl>
        </div>
        <form asp-action="Delete" method="post">
            @* FIX: Use the correct primary key property name, Id, for the hidden input *@
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger px-4">Delete</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
        </form>
    </div>
</div>