@model IEnumerable<EventApp.Models.Event>

@{
    ViewData["Title"] = "Events";
    var canManageEvents = User.IsInRole("Admin") || User.IsInRole("Organizer");
}

<div class="container mt-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="text-primary fw-bold mb-1">Upcoming Events</h1>
            <p class="text-muted mb-0">Browse published events and purchase tickets while seats are still available.</p>
        </div>
        @if (canManageEvents)
        {
            <a asp-action="Create" class="btn btn-primary shadow">
                <i class="bi bi-plus-circle me-2"></i>Create New Event
            </a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive mb-5">
            <table class="table table-hover align-middle shadow-sm rounded-3 overflow-hidden">
                <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Price</th>
                    <th>Available</th>
                    <th class="text-center">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Category</td>
                        <td>@item.EventDate.ToShortDateString()</td>
                        <td>@item.EventDate.ToShortTimeString()</td>
                        <td>@item.TicketPrice.ToString("C")</td>
                        <td>
                            <span class="fw-semibold @(item.AvailableTickets > 0 ? "text-success" : "text-danger")">
                                @item.AvailableTickets
                            </span>
                        </td>
                        <td class="text-center">
                            <div class="btn-group" role="group">
                                <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@item.Id" aria-label="View details for @item.Title">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (canManageEvents)
                                {
                                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit @item.Title">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id" aria-label="Delete @item.Title">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="row">
            @foreach (var eventItem in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <span class="badge rounded-pill bg-light text-dark mb-3">@eventItem.Category</span>
                            <h2 class="h5 card-title text-primary fw-bold">@eventItem.Title</h2>
                            <p class="card-text text-muted">@eventItem.Description</p>
                            <p class="card-text mb-0">
                                <strong>Date:</strong> @eventItem.EventDate.ToString("f")<br />
                                <strong>Location:</strong> @eventItem.Location<br />
                                <strong>Price:</strong> @eventItem.TicketPrice.ToString("C")<br />
                                <strong>Available:</strong>
                                <span class="fw-bold @(eventItem.AvailableTickets > 0 ? "text-success" : "text-danger")">@eventItem.AvailableTickets</span>
                            </p>
                        </div>
                        <div class="card-footer text-center bg-light border-0 d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@eventItem.Id" class="btn btn-outline-primary">View Details</a>
                            @if (eventItem.AvailableTickets > 0)
                            {
                                <a asp-controller="Purchase" asp-action="Create" asp-route-eventId="@eventItem.Id" class="btn btn-success">
                                    Buy Ticket
                                </a>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">Sold Out</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center" role="alert">
            <h4 class="alert-heading">No Events Found</h4>
            <p class="mb-0">There are no events scheduled yet.</p>
        </div>
    }
</div>
