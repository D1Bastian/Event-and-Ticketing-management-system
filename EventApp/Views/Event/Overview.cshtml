@{
    ViewData["Title"] = "Event Overview";
}

<div class="container mt-5">
    <h1 class="text-primary mb-4">Event Overview</h1>

    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-4">
            <div class="card text-center h-100 shadow-sm border-primary">
                <div class="card-body">
                    <h2 class="h5 card-title text-primary fw-semibold">Total Events Scheduled</h2>
                    <div class="display-4 fw-bold">@ViewBag.TotalEvents</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card text-center h-100 shadow-sm border-success">
                <div class="card-body">
                    <h2 class="h5 card-title text-success fw-semibold">Unique Categories</h2>
                    <div class="display-4 fw-bold">@ViewBag.TotalCategories</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card text-center h-100 shadow-sm border-info">
                <div class="card-body">
                    <h2 class="h5 card-title text-info fw-semibold">Tickets Available</h2>
                    <div class="display-4 fw-bold">@ViewBag.TotalAvailableTickets</div>
                </div>
            </div>
        </div>
    </div>

    <hr class="my-4" />
    <h2 class="h4 text-warning mb-3 fw-bold">Events Under $5</h2>

    @if (ViewBag.LowPriceEvents is List<EventApp.Models.Event> lowPriceEvents && lowPriceEvents.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Price</th>
                    <th>Available Tickets</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var eventItem in lowPriceEvents)
                {
                    <tr>
                        <td>@eventItem.Title</td>
                        <td>@eventItem.Category</td>
                        <td>@eventItem.EventDate.ToShortDateString()</td>
                        <td class="text-warning fw-bold">@eventItem.TicketPrice.ToString("C")</td>
                        <td>@eventItem.AvailableTickets</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-success border-0 shadow-sm">
            <h3 class="h5 alert-heading">No bargain-bin events right now</h3>
            <p class="mb-0">Every listed event is currently priced above $5.</p>
        </div>
    }
</div>
