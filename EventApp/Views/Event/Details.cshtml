@model EventApp.Models.Event

@{
    ViewData["Title"] = "Event Details";
    var canManageEvents = User.IsInRole("Admin") || User.IsInRole("Organizer");
}

<div class="container mt-5">
    <div class="card shadow-lg p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <span class="badge rounded-pill bg-light text-dark mb-3">@Model.Category</span>
                <h1 class="text-info fw-bold mb-2">@Model.Title</h1>
                <p class="text-muted mb-0">@Model.Description</p>
            </div>
            <div class="text-end">
                <div class="fs-4 fw-bold text-success">@Model.TicketPrice.ToString("C")</div>
                <div class="text-muted">@Model.AvailableTickets of @Model.Capacity tickets left</div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 border-end">
                <p class="mb-2"><strong>Location:</strong> @Model.Location</p>
                <p class="mb-2"><strong>Date:</strong> @Model.EventDate.ToShortDateString()</p>
                <p class="mb-2"><strong>Time:</strong> @Model.EventDate.ToShortTimeString()</p>
            </div>
            <div class="col-md-6">
                <p class="mb-2"><strong>Ticket Price:</strong> @Model.TicketPrice.ToString("C")</p>
                <p class="mb-2"><strong>Available Tickets:</strong> @Model.AvailableTickets</p>
                <p class="mb-0"><strong>Total Capacity:</strong> @Model.Capacity</p>
            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
            @if (Model.AvailableTickets > 0)
            {
                <a asp-controller="Purchase" asp-action="Create" asp-route-eventId="@Model.Id" class="btn btn-success px-4">
                    <i class="bi bi-ticket-perforated me-2"></i>Buy Ticket
                </a>
            }
            @if (canManageEvents)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning px-4">
                    <i class="bi bi-pencil me-2"></i>Edit
                </a>
            }
            <a asp-action="Index" class="btn btn-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>
</div>
