@model EventApp.Models.PurchaseRequestViewModel

@{
    ViewData["Title"] = "Purchase Tickets";
}

<div class="container mt-5">
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mb-3">Ticket Checkout</span>
                    <h1 class="h3 text-primary">@Model.EventTitle</h1>
                    <p class="text-muted mb-4">Confirm your details and complete the purchase.</p>
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Date</dt>
                        <dd class="col-sm-7">@Model.EventDate.ToString("f")</dd>
                        <dt class="col-sm-5">Location</dt>
                        <dd class="col-sm-7">@Model.Location</dd>
                        <dt class="col-sm-5">Price</dt>
                        <dd class="col-sm-7">@Model.TicketPrice.ToString("C")</dd>
                        <dt class="col-sm-5">Available</dt>
                        <dd class="col-sm-7">@Model.AvailableTickets</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="h4 mb-4">Secure Ticket Checkout</h2>

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <form asp-action="Create" method="post">
                        <input asp-for="EventId" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="GuestName" class="form-label"></label>
                            <input asp-for="GuestName" class="form-control" autocomplete="name" />
                            <span asp-validation-for="GuestName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GuestEmail" class="form-label"></label>
                            <input asp-for="GuestEmail" class="form-control" autocomplete="email" />
                            <span asp-validation-for="GuestEmail" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label"></label>
                            <input asp-for="Quantity" class="form-control" min="1" max="@Math.Max(Model.AvailableTickets, 1)" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-shield-lock me-2"></i>Complete Purchase
                            </button>
                            <a asp-controller="Event" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-outline-secondary">
                                Back to Event
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
