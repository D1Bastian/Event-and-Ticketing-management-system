@model EventApp.Models.Purchase
@{
    var eventItem = ViewBag.Event as EventApp.Models.Event;
}

<div class="container mt-5">
    <h2 class="text-primary mb-4">Purchase Tickets for @eventItem.Title</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Create" method="post">
        <input type="hidden" name="eventId" value="@eventItem.Id" />

        <div class="mb-3">
            <label class="form-label">Your Name</label>
            <input type="text" name="guestName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" name="guestEmail" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Quantity (Available: @eventItem.AvailableTickets)</label>
            <input type="number" name="quantity" class="form-control" min="1" max="@eventItem.AvailableTickets" required />
        </div>

        <button type="submit" class="btn btn-success">Purchase</button>
    </form>
</div>