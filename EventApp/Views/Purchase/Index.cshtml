@model IEnumerable<EventApp.Models.Purchase>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-primary mb-1">Purchase Summary</h1>
            <p class="text-muted mb-0">Organizer-only view of completed ticket orders.</p>
        </div>
        <a asp-controller="Event" asp-action="Index" class="btn btn-outline-secondary">Back to Events</a>
    </div>

    @if (Model.Any())
    {
        var purchases = Model.ToList();

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Guest Name</th>
                    <th>Email</th>
                    <th>Event</th>
                    <th>Quantity</th>
                    <th>Total Cost</th>
                    <th>Purchase Date</th>
                    <th>Receipt</th>
                </tr>
                </thead>
                <tbody>
                @for (var i = 0; i < purchases.Count; i++)
                {
                    var purchase = purchases[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@purchase.GuestName</td>
                        <td>@purchase.GuestEmail</td>
                        <td>@purchase.Event?.Title</td>
                        <td>@purchase.Quantity</td>
                        <td>@purchase.TotalCost.ToString("C")</td>
                        <td>@purchase.PurchaseDate.ToString("g")</td>
                        <td>
                            <a asp-action="Confirmation" asp-route-id="@purchase.PurchaseId" class="btn btn-info btn-sm">
                                View
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No purchases have been made yet.</div>
    }
</div>
