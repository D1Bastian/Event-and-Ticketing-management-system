@model EventApp.Models.Purchase

@{
    ViewData["Title"] = "Purchase Confirmation";
    var canViewPurchaseSummary = ViewBag.CanViewPurchaseSummary as bool? ?? false;
    var showConfetti = ViewBag.ShowConfetti as bool? ?? false;
}

<div class="container mt-5 position-relative">
    @if (showConfetti)
    {
        <div class="confetti-burst" data-confetti aria-hidden="true"></div>
    }

    <div class="card shadow-lg border-0">
        <div class="card-body p-4 p-lg-5">
            <span class="badge rounded-pill bg-success-subtle text-success-emphasis mb-3">Purchase confirmed</span>
            <h1 class="text-success mb-3">Your tickets are secured</h1>
            <p class="text-muted">This receipt is private and only available with the confirmation link or organizer access.</p>

            <div class="row g-4 mt-2">
                <div class="col-lg-6">
                    <h2 class="h5">Event</h2>
                    <p class="mb-1"><strong>@Model.Event?.Title</strong></p>
                    <p class="mb-1">@Model.Event?.Location</p>
                    <p class="mb-0">@Model.Event?.EventDate.ToString("f")</p>
                </div>
                <div class="col-lg-6">
                    <h2 class="h5">Receipt</h2>
                    <p class="mb-1"><strong>Guest Name:</strong> @Model.GuestName</p>
                    <p class="mb-1"><strong>Email:</strong> @Model.GuestEmail</p>
                    <p class="mb-1"><strong>Purchase Date:</strong> @Model.PurchaseDate.ToString("g")</p>
                    <p class="mb-1"><strong>Quantity:</strong> @Model.Quantity</p>
                    <p class="mb-0"><strong>Total Cost:</strong> @Model.TotalCost.ToString("C")</p>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-controller="Event" asp-action="Index" class="btn btn-primary">Back to Events</a>
                @if (canViewPurchaseSummary)
                {
                    <a asp-controller="Purchase" asp-action="Index" class="btn btn-outline-secondary">View Purchase Summary</a>
                }
            </div>
        </div>
    </div>
</div>
