@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home";
    var canManageEvents = User.IsInRole("Admin") || User.IsInRole("Organizer");
}

<div class="container py-5">
    <div class="row align-items-center g-4 mb-5">
        <div class="col-lg-7">
            <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis mb-3">ASP.NET Core MVC + PostgreSQL</span>
            <h1 class="display-5 fw-bold text-dark">Event-and-Tickecting-management-system</h1>
            <p class="lead text-muted">
                Publish events, browse schedules, search by date or category, and complete guest ticket purchases with private receipt links.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-controller="Event" asp-action="Index" class="btn btn-primary btn-lg">
                    <i class="bi bi-calendar-event me-2"></i>Explore Events
                </a>
                <a asp-controller="Event" asp-action="Search" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-search me-2"></i>Search Events
                </a>
                @if (canManageEvents)
                {
                    <a asp-controller="Event" asp-action="Create" class="btn btn-success btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>Create Event
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-4">
                    <h2 class="h4 fw-semibold mb-3">What the app covers</h2>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3"><i class="bi bi-shield-check text-success me-2"></i>Role-based event management for admins and organizers</li>
                        <li class="mb-3"><i class="bi bi-ticket-perforated text-primary me-2"></i>Guest-friendly ticket purchases with live inventory checks</li>
                        <li class="mb-3"><i class="bi bi-receipt text-warning me-2"></i>Protected purchase receipts instead of public confirmation pages</li>
                        <li><i class="bi bi-funnel text-info me-2"></i>Search and browse flows for categories, dates, pricing, and availability</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3 class="h5 card-title"><i class="bi bi-diagram-3 me-2 text-primary"></i>Organizer Workflow</h3>
                    <p class="card-text text-muted mb-0">
                        Create, edit, and delete events while keeping capacity and available ticket counts consistent.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3 class="h5 card-title"><i class="bi bi-compass me-2 text-success"></i>Attendee Discovery</h3>
                    <p class="card-text text-muted mb-0">
                        Browse upcoming events, compare prices, and filter by category or ticket status before checkout.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h3 class="h5 card-title"><i class="bi bi-lock me-2 text-danger"></i>Security Defaults</h3>
                    <p class="card-text text-muted mb-0">
                        Anti-forgery validation, HTTPS redirects, secured cookies, and restrictive response headers are baked in.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
