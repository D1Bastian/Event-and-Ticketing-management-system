@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home";
    var canManageEvents = User.IsInRole("Admin") || User.IsInRole("Organizer");
}

<div class="container py-4">
    <div class="row align-items-center g-5 py-5 mb-5 rounded-4 shadow-sm" style="background: linear-gradient(135deg, rgba(67, 97, 238, 0.05) 0%, rgba(76, 201, 240, 0.1) 100%);">
        <div class="col-lg-7 px-5">
            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 fw-semibold border border-primary border-opacity-25" style="letter-spacing: 1px;">THE PREMIER PLATFORM</span>
            <h1 class="display-4 fw-bolder text-dark mb-4" style="line-height: 1.2;">Unforgettable Events<br/><span style="color: var(--primary-color);">Start Here</span></h1>
            <p class="lead text-muted mb-4 pe-lg-4" style="font-size: 1.2rem;">
                Discover, book, and experience the best concerts, workshops, and meetups happening around you. Get your tickets instantly with our secure checkout.
            </p>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a asp-controller="Event" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 shadow-sm">
                    <i class="bi bi-calendar-event me-2"></i>Explore Events
                </a>
                <a asp-controller="Event" asp-action="Search" class="btn btn-outline-dark btn-lg rounded-pill px-4">
                    <i class="bi bi-search me-2"></i>Search Now
                </a>
                @if (canManageEvents)
                {
                    <a asp-controller="Event" asp-action="Create" class="btn btn-success btn-lg rounded-pill px-4 ms-auto shadow-sm">
                        <i class="bi bi-plus-circle me-2"></i>Create Event
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-5 text-center d-none d-lg-block">
            <div class="position-relative">
                <img src="/docs/images/event-ticket-management-system-hero.png" class="img-fluid rounded-4 shadow-lg" alt="Event Hero Image" style="transform: perspective(1000px) rotateY(-5deg); transition: transform 0.5s ease; cursor: pointer;" onmouseover="this.style.transform='perspective(1000px) rotateY(0deg) scale(1.02)'" onmouseout="this.style.transform='perspective(1000px) rotateY(-5deg)'" />
                <div class="position-absolute bottom-0 start-0 translate-middle-x bg-white p-3 rounded-4 shadow-lg" style="margin-bottom: 20px;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-check-lg fs-4"></i>
                        </div>
                        <div class="text-start">
                            <h6 class="mb-0 fw-bold">Secure Checkout</h6>
                            <small class="text-muted">Instant delivery</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="text-center mb-5 mt-5">
        <h2 class="fw-bold mb-3">Why Choose Us</h2>
        <p class="text-muted mx-auto" style="max-width: 600px;">We provide a seamless end-to-end experience for finding events and securing your tickets without hassle.</p>
    </div>

    <div class="row g-4 mb-5 pb-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 p-4 text-center">
                <div class="card-body">
                    <div class="mb-4 text-primary">
                        <i class="bi bi-ticket-detailed display-4"></i>
                    </div>
                    <h3 class="h5 card-title fw-bold">Instant e-Tickets</h3>
                    <p class="card-text text-muted">
                        Get your digital tickets delivered instantly to your private receipt link. No accounts required.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 p-4 text-center">
                <div class="card-body">
                    <div class="mb-4 text-accent" style="color: var(--accent-color);">
                        <i class="bi bi-lightning-charge display-4"></i>
                    </div>
                    <h3 class="h5 card-title fw-bold">Real-time Availability</h3>
                    <p class="card-text text-muted">
                        See exactly how many spots are left. Our live inventory tracking prevents overbooking.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 p-4 text-center">
                <div class="card-body">
                    <div class="mb-4 text-secondary" style="color: var(--secondary-color);">
                        <i class="bi bi-shield-check display-4"></i>
                    </div>
                    <h3 class="h5 card-title fw-bold">Bank-grade Security</h3>
                    <p class="card-text text-muted">
                        Your data and purchases are protected with the highest standard of industry security.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
