@model Event
@{
    ViewData["Title"] = "Publish an event";
}
<section class="form-page"><div class="form-intro"><p class="eyebrow">Organizer studio</p><h1>Put something great on the calendar.</h1><p>Clear information helps the right people find and attend your event.</p></div>
<form asp-action="Create" method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="form-grid"><label asp-for="Title"></label><input asp-for="Title" autofocus /><span asp-validation-for="Title" class="validation"></span><label asp-for="Category"></label><input asp-for="Category" placeholder="Music, Technology, Social…" /><span asp-validation-for="Category" class="validation"></span><label asp-for="Location"></label><input asp-for="Location" /><span asp-validation-for="Location" class="validation"></span><label asp-for="EventDate"></label><input asp-for="EventDate" type="datetime-local" /><span asp-validation-for="EventDate" class="validation"></span><label asp-for="Description" class="form-full"></label><textarea asp-for="Description" class="form-full" rows="5"></textarea><span asp-validation-for="Description" class="validation form-full"></span><label asp-for="Capacity"></label><input asp-for="Capacity" min="1" /><span asp-validation-for="Capacity" class="validation"></span><label asp-for="AvailableTickets"></label><input asp-for="AvailableTickets" min="0" /><span asp-validation-for="AvailableTickets" class="validation"></span><label asp-for="TicketPrice"></label><input asp-for="TicketPrice" min="0" step="0.01" /><span asp-validation-for="TicketPrice" class="validation"></span></div>
    <div class="form-actions"><a class="button button-quiet" asp-action="Index">Cancel</a><button class="button" type="submit">Publish event</button></div>
</form></section>
