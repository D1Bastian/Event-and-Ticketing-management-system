@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

<div class="account-nav">
@if (SignInManager.IsSignedIn(User))
{
    <span class="account-greeting">Hi, @User.Identity?.Name</span>
    <form asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="button button-quiet">Sign out</button>
    </form>
}
else
{
    <a class="button button-quiet" asp-controller="Account" asp-action="Login">Sign in</a>
    <a class="button button-small" asp-controller="Account" asp-action="Register">Create account</a>
}
</div>
