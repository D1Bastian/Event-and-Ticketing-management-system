<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TicketZ helps people discover, publish, and attend memorable events." />
    <title>@ViewData["Title"] · TicketZ</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="shell nav" aria-label="Main navigation">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="TicketZ home">
                <span class="brand-mark" aria-hidden="true">TZ</span><span>TicketZ</span>
            </a>
            <div class="nav-links">
                <a asp-controller="Event" asp-action="Index">Discover</a>
                <a asp-controller="Event" asp-action="BrowseEvent">Categories</a>
                <a asp-controller="Event" asp-action="Search">Find an event</a>
                @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
                {
                    <a asp-controller="Event" asp-action="Overview">Studio</a>
                    <a asp-controller="Purchase" asp-action="Index">Sales</a>
                }
            </div>
            <partial name="_LoginPartial" />
        </nav>
    </header>

    <main class="shell page-shell">
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error" role="alert">@error</div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="shell footer-inner"><span>TicketZ · Experiences worth showing up for.</span><span>© @DateTime.UtcNow.Year</span></div>
    </footer>
</body>
</html>
