@model IEnumerable<Purchase>
@{
    ViewData["Title"] = "Ticket sales";
    var totalTickets = Model.Sum(p => p.Quantity);
    var totalRevenue = Model.Sum(p => p.TotalCost);
}
<section class="page-heading"><div><p class="eyebrow">Organizer studio</p><h1>Every yes, in one view.</h1><p class="lead">Recent reservations and a quick read on sales momentum.</p></div></section>
<section class="metric-grid"><article><span>Reservations</span><strong>@Model.Count()</strong><p>completed purchases</p></article><article><span>Tickets</span><strong>@totalTickets</strong><p>claimed seats</p></article><article><span>Revenue</span><strong>@totalRevenue.ToString("C")</strong><p>across completed purchases</p></article></section>
<section class="panel table-panel"><div class="section-heading"><div><p class="eyebrow">Purchase feed</p><h2>Latest reservations</h2></div></div>
@if (Model.Any()) { <div class="table-wrap"><table><thead><tr><th>Receipt email</th><th>Event</th><th>Tickets</th><th>Paid</th><th>Purchased</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.GuestEmail</strong></td><td>@item.Event?.Title</td><td>@item.Quantity</td><td>@item.TotalCost.ToString("C")</td><td>@item.PurchaseDate.ToLocalTime().ToString("MMM d, yyyy")</td></tr> }</tbody></table></div> }
else { <p class="muted">No reservations yet. Share your event page to get started.</p> }
</section>
